# Managed by Ansible (role: logstash)
input {
  beats {
    port => {{ logstash_beats_port }}
  }
  tcp {
    port => {{ logstash_tcp_port }}
    codec => line
  }
}

output {
  elasticsearch {
    hosts => ["http://{{ hostvars[groups['elasticsearch'][0]]['ansible_host'] }}:9200"]
    index => "logstash-%{+YYYY.MM.dd}"
  }
}
